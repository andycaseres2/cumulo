---
import { games } from '@/composition/games';
import { theory } from '@/composition/theory';
import GameCard from '@/modules/games/presentation/GameCard.astro';
import { isPlayable } from '@/modules/games/domain/Game';
import { EXAM_FORMAT } from '@/modules/exam/domain/ExamFormat';
import DomainOverview from '@/modules/theory/presentation/DomainOverview.astro';
import Button from '@/ui/atoms/Button.astro';
import Container from '@/ui/atoms/Container.astro';
import PageLayout from '@/ui/layouts/PageLayout.astro';
import Card from '@/ui/molecules/Card.astro';
import SectionHeading from '@/ui/molecules/SectionHeading.astro';
import Hero from '@/ui/organisms/Hero.astro';
import { pagesMessages } from '@/i18n/messages/pages';
import { localeOf, localePaths } from '@/i18n/page';
import { routesFor } from '@/ui/routes';
import { SITE_NAME } from '@/ui/site';

export function getStaticPaths() {
  return localePaths();
}

const locale = localeOf(Astro);
const routes = routesFor(locale);
const t = pagesMessages[locale].home;

const allGames = await games.list(locale);
const featured = allGames.find(isPlayable);
const playableCount = allGames.filter(isPlayable).length;
const catalog = await theory.catalog(locale);
const topicCount = catalog.reduce((sum, section) => sum + section.topics.length, 0);
---

<PageLayout
  title={SITE_NAME}
  description={t.description}
>
  <Hero
    eyebrow={t.heroEyebrow}
    title={t.heroTitle}
    lead={t.heroLead}
  >
    <Fragment slot="actions">
      {featured && <Button href={routes.game(featured.slug)} size="lg">{t.play(featured.title)}</Button>}
      <Button href={routes.theory} variant="secondary" size="lg">{t.studyTheory}</Button>
    </Fragment>
    <Fragment slot="art">
      <img
        class="hero-art"
        src="/images/games/cumulo-city.png"
        alt={t.heroAlt}
        width="1280"
        height="713"
      />
    </Fragment>
  </Hero>

  <Container>
    <section class="section" aria-labelledby="como-prepararte">
      <SectionHeading
        id="como-prepararte"
        eyebrow={t.pathsEyebrow}
        title={t.pathsTitle}
        description={t.pathsDescription}
      />
      <ul class="paths">
        <li>
          <Card>
            <h3>{t.gamesTitle}</h3>
            <p>{t.gamesText}</p>
            <p class="stat">{t.gamesStat(playableCount, allGames.length - playableCount)}</p>
            <Fragment slot="footer"><Button href={routes.games}>{t.gamesAction}</Button></Fragment>
          </Card>
        </li>
        <li>
          <Card accent="var(--color-domain-cloud-concepts)">
            <h3>{t.theoryTitle}</h3>
            <p>{t.theoryText}</p>
            <p class="stat">{t.theoryStat(topicCount)}</p>
            <Fragment slot="footer"><Button href={routes.theory} variant="secondary">{t.theoryAction}</Button></Fragment>
          </Card>
        </li>
        <li>
          <Card accent="var(--color-domain-security-compliance)">
            <h3>{t.examTitle}</h3>
            <p>{t.examText}</p>
            <p class="stat">{t.examStat(EXAM_FORMAT.questions, EXAM_FORMAT.durationMinutes)}</p>
            <Fragment slot="footer"><Button href={routes.practiceExam} variant="secondary">{t.examAction}</Button></Fragment>
          </Card>
        </li>
      </ul>
    </section>

    {
      featured && (
        <section class="section" aria-labelledby="juego-destacado">
          <SectionHeading id="juego-destacado" eyebrow={t.featuredEyebrow} title={featured.title} />
          <div class="featured">
            <GameCard game={featured} />
          </div>
        </section>
      )
    }

    <section class="section" aria-labelledby="dominios">
      <SectionHeading
        id="dominios"
        eyebrow={t.domainsEyebrow}
        title={t.domainsTitle}
        description={t.domainsDescription}
      />
      <DomainOverview sections={catalog} />
    </section>
  </Container>
</PageLayout>

<style>
  .hero-art {
    display: block;
    width: 100%;
    height: auto;
    image-rendering: pixelated;
    border: var(--border-width) solid var(--color-shadow);
    border-radius: var(--radius);
    box-shadow: 8px 8px 0 var(--color-shadow);
  }

  .section {
    padding-top: var(--space-16);
  }

  .paths {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-8);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .paths h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .paths p {
    margin: 0;
    color: var(--color-text-muted);
  }

  .paths .stat {
    font-weight: 700;
    color: var(--color-text);
  }

  .featured {
    max-width: 32rem;
  }
</style>
