---
import { theory } from '@/composition/theory';
import ExamFormatCard from '@/modules/exam/presentation/ExamFormatCard.astro';
import CoverageSummary from '@/modules/theory/presentation/CoverageSummary.astro';
import DomainSection from '@/modules/theory/presentation/DomainSection.astro';
import Container from '@/ui/atoms/Container.astro';
import PageLayout from '@/ui/layouts/PageLayout.astro';
import Breadcrumbs from '@/ui/molecules/Breadcrumbs.astro';
import SectionHeading from '@/ui/molecules/SectionHeading.astro';
import { pagesMessages } from '@/i18n/messages/pages';
import { localeOf, localePaths } from '@/i18n/page';
import { routesFor } from '@/ui/routes';

const locale = localeOf(Astro);
const routes = routesFor(locale);
const t = pagesMessages[locale].theory;

export function getStaticPaths() {
  // Every topic belongs to the first course until the platform offers more than one.
  const [course] = theory.courses();
  return localePaths().map(({ params }) => ({ params: { ...params, course: course.slug }, props: { course: theory.findCourse(course.slug, params.lang)! } }));
}

const { course } = Astro.props;
const [catalog, coverage] = await Promise.all([theory.catalog(locale), theory.coverage(locale)]);
---

<PageLayout
  title={t.courseTitle(course.title)}
  description={t.courseDescription(course.title, course.examCode)}
>
  <Container>
    <div class="page">
      <Breadcrumbs items={[{ label: t.title, href: routes.theory }, { label: course.title }]} />
      <SectionHeading
        level={1}
        eyebrow={t.courseEyebrow(course.examCode)}
        title={course.title}
        description={t.courseLead(course.examCode)}
      />
      <div class="overview">
        <ExamFormatCard />
        <CoverageSummary coverage={coverage} />
      </div>
      {catalog.map((section) => <DomainSection section={section} />)}
    </div>
  </Container>
</PageLayout>

<style>
  .page {
    padding-top: var(--space-12);
  }

  .overview {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: var(--space-6);
    margin-bottom: var(--space-12);
  }
</style>

<script>
  import { theoryProgressStore } from '@/composition/theoryProgress';
  import { currentLocale } from '@/i18n/client';
  import { pagesMessages } from '@/i18n/messages/pages';

  const t = pagesMessages[currentLocale()].theory;

  // Marks the topics this visitor completed and counts them per domain.
  const completed = new Set(await (await theoryProgressStore()).load());
  for (const item of document.querySelectorAll<HTMLElement>('[data-topic]')) {
    const badge = item.querySelector<HTMLElement>('[data-done]');
    if (badge) badge.hidden = !completed.has(item.dataset.topic!);
  }
  for (const progress of document.querySelectorAll<HTMLElement>('[data-domain-progress]')) {
    const section = progress.closest('section')!;
    const done = [...section.querySelectorAll<HTMLElement>('[data-topic]')].filter((t) => completed.has(t.dataset.topic!)).length;
    progress.textContent = t.completed(done, progress.dataset.total ?? '');
    progress.hidden = false;
  }
</script>
