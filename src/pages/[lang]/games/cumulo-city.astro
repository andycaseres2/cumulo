---
import GameLayout from '@/ui/layouts/GameLayout.astro';
import { localeOf, localePaths } from '@/i18n/page';
import { routesFor } from '@/ui/routes';
import { gameMessages } from '@/i18n/messages/game';

export function getStaticPaths() {
  return localePaths();
}

const locale = localeOf(Astro);
const routes = routesFor(locale);
const text = gameMessages[locale].page;
---

<GameLayout
  title={text.title}
  description={text.description}
  exitHref={routes.games}
>
  <div class="game-root" data-cumulo-city></div>
</GameLayout>

<style>
  /* Positioned so the mission panel overlay covers the game. */
  .game-root {
    position: relative;
    width: 100%;
    height: 100%;
  }

  /*
   * Behind the sign-in modal. A player who still has to pick a character sees the plain background
   * of the selection screen; one who already picked sees the city they are going back to.
   */
  .game-root.is-intro {
    background: #1d2b53;
  }

  .game-root.is-locked {
    background: url('/images/games/cumulo-city.png') center / cover no-repeat;
    image-rendering: pixelated;
  }
</style>

<script>
  import { gameMissions } from '@/composition/missions';
  import { chooseCharacter, currentPlayer, deviceHasCharacter, playerAuth, rememberCharacterOnDevice } from '@/composition/player';
  import { mountCumuloCity } from '@/modules/games/cumulo-city/mount';
  import { openAuthModal } from '@/modules/player/presentation/authModal';
  import { currentLocale } from '@/i18n/client';
  import { gameMessages } from '@/i18n/messages/game';
  import { routesFor } from '@/ui/routes';

  const locale = currentLocale();
  const routes = routesFor(locale);

  const root = document.querySelector<HTMLElement>('[data-cumulo-city]');
  if (root) {
    const player = await currentPlayer();
    if (player.isGuest) {
      // Playing requires an account: ask for it right here, over what the player will see next.
      root.classList.add(deviceHasCharacter() ? 'is-locked' : 'is-intro');
      openAuthModal({
        auth: playerAuth(),
        reason: gameMessages[locale].page.authReason,
        onSignedIn: () => window.location.reload(),
        onDismiss: () => window.location.assign(routes.games),
      });
    } else {
      if (player.character) rememberCharacterOnDevice();
      await mountCumuloCity(root, {
        playerName: player.displayName,
        locale,
        missions: gameMissions(root),
        character: player.character,
        onCharacterChosen: (character) => void chooseCharacter(character),
      });
    }
  }
</script>
