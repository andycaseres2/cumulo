---
import { games } from '@/composition/games';
import GameGrid from '@/modules/games/presentation/GameGrid.astro';
import Container from '@/ui/atoms/Container.astro';
import PageLayout from '@/ui/layouts/PageLayout.astro';
import SectionHeading from '@/ui/molecules/SectionHeading.astro';
import { pagesMessages } from '@/i18n/messages/pages';
import { localeOf, localePaths } from '@/i18n/page';

export function getStaticPaths() {
  return localePaths();
}

const locale = localeOf(Astro);
const t = pagesMessages[locale].games;
const allGames = await games.list(locale);
---

<PageLayout title={t.title} description={t.description}>
  <Container>
    <div class="page">
      <SectionHeading
        level={1}
        eyebrow={t.eyebrow}
        title={t.heading}
        description={t.lead}
      />
      <GameGrid games={allGames} />
    </div>
  </Container>
</PageLayout>

<style>
  .page {
    padding-top: var(--space-12);
  }
</style>
