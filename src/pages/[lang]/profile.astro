---
import { theory } from '@/composition/theory';
import { ALL_BUILDINGS, DISTRICTS } from '@/modules/games/cumulo-city/world/districts';
import Container from '@/ui/atoms/Container.astro';
import PageLayout from '@/ui/layouts/PageLayout.astro';
import SectionHeading from '@/ui/molecules/SectionHeading.astro';
import { localeOf, localePaths } from '@/i18n/page';

export function getStaticPaths() {
  return localePaths();
}

const locale = localeOf(Astro);

// Names known at build time, handed to the client view that renders the player's progress.
const topics = (await theory.catalog(locale)).flatMap((s) => s.topics);
const topicTitles = Object.fromEntries(topics.map((t) => [t.slug, t.title]));
const buildingNames = Object.fromEntries(ALL_BUILDINGS.map((b) => [b.id, b.name]));
const districtNames = Object.fromEntries(DISTRICTS.map((d) => [d.id, d.name]));
---

<PageLayout title="Mi perfil" description="Tu cuenta, los temas de teoría que completaste, tus misiones en Cúmulo City y los dominios del examen que ya practicaste.">
  <Container width="reading">
    <div class="page">
      <SectionHeading
        level={1}
        eyebrow="Tu cuenta"
        title="Mi perfil"
        description="Tu cuenta y tu avance: los temas de teoría que completaste, las misiones que resolviste en Cúmulo City y los dominios del examen CLF-C02 que ya practicaste."
      />
      <div data-profile></div>
      <h2 class="section-title">Teoría</h2>
      <div data-theory-progress data-topics={JSON.stringify(topics)}></div>
      <h2 class="section-title">Duelo de servicios</h2>
      <div data-duel-progress></div>
      <h2 class="section-title">Misiones</h2>
      <div data-progress data-topics={JSON.stringify(topicTitles)} data-buildings={JSON.stringify(buildingNames)} data-districts={JSON.stringify(districtNames)}>
        <p class="loading">Cargando tu progreso…</p>
      </div>
    </div>
  </Container>
</PageLayout>

<style>
  .page {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-12);
  }

  .section-title {
    margin: var(--space-6) 0 calc(var(--space-2) * -1);
    font-family: var(--font-display);
    font-size: var(--text-lg);
  }

  .loading {
    color: var(--color-text-muted);
  }
</style>

<script>
  import { duelProgressStore } from '@/composition/duel';
  import { campaignOverview } from '@/composition/missions';
  import { currentPlayer, playerAuth } from '@/composition/player';
  import { renderProgress } from '@/modules/missions/presentation/progressView';
  import { openAuthModal } from '@/modules/player/presentation/authModal';
  import { renderProfileCard } from '@/modules/player/presentation/profileCard';
  import { theoryProgressStore } from '@/composition/theoryProgress';
  import { getTheoryOverview } from '@/modules/theory/application/theoryProgress';
  import type { Topic } from '@/modules/theory/domain/Topic';
  import { FAMILY_ORDER } from '@/modules/duel/infrastructure/familyOrder';
  import { RIVALS } from '@/modules/duel/infrastructure/rivals';
  import { renderDuelProgress } from '@/modules/duel/presentation/duelProgressView';
  import { renderTheoryProgress } from '@/modules/theory/presentation/theoryProgressView';
  import { currentLocale } from '@/i18n/client';
  import { routesFor } from '@/ui/routes';

  const routes = routesFor(currentLocale());

  const host = document.querySelector<HTMLElement>('[data-progress]');
  if (host) {
    const player = await currentPlayer();
    if (player.isGuest) {
      host.replaceChildren();
      openAuthModal({
        auth: playerAuth(),
        reason: 'Ingresa para ver tu perfil y tu progreso en las misiones.',
        onSignedIn: () => window.location.reload(),
        onDismiss: () => window.location.assign(routes.home),
      });
    } else {
      renderProfileCard(document.querySelector<HTMLElement>('[data-profile]')!, player);
      const theoryHost = document.querySelector<HTMLElement>('[data-theory-progress]')!;
      const allTopics: Topic[] = JSON.parse(theoryHost.dataset.topics ?? '[]');
      renderTheoryProgress(theoryHost, await getTheoryOverview(await theoryProgressStore(), allTopics), { theoryUrl: routes.course('cloud-practitioner') });
      renderDuelProgress(document.querySelector<HTMLElement>('[data-duel-progress]')!, await (await duelProgressStore()).load(), {
        rivals: RIVALS,
        familyCount: FAMILY_ORDER.length,
        gameUrl: routes.game('service-duel'),
      });
      const topics: Record<string, string> = JSON.parse(host.dataset.topics ?? '{}');
      const buildings: Record<string, string> = JSON.parse(host.dataset.buildings ?? '{}');
      const districts: Record<string, string> = JSON.parse(host.dataset.districts ?? '{}');
      renderProgress(host, await campaignOverview(), {
        gameUrl: routes.game('cumulo-city'),
        theoryUrl: routes.topic,
        buildingName: (id) => buildings[id] ?? id,
        topicTitle: (slug) => topics[slug] ?? slug,
        trackName: (track) => districts[track] ?? track,
      });
    }
  }
</script>
