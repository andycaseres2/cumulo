---
// The sign-in page before the language prefix. Confirmation emails sent back then land here with their
// query and hash, so they are forwarded as they are (a static redirect would drop them).
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex" />
    <title>Cúmulo</title>
    <script is:inline>
      window.location.replace('/es/sign-in' + window.location.search + window.location.hash);
    </script>
  </head>
  <body><a href="/es/sign-in">Ingresar</a></body>
</html>
