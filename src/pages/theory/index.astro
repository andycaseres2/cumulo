---
import { theory } from '@/composition/theory';
import CourseCard from '@/modules/theory/presentation/CourseCard.astro';
import Container from '@/ui/atoms/Container.astro';
import PageLayout from '@/ui/layouts/PageLayout.astro';
import SectionHeading from '@/ui/molecules/SectionHeading.astro';

const catalog = await theory.catalog();
const topics = catalog.flatMap((section) => section.topics);
const readingMinutes = topics.reduce((total, topic) => total + topic.readingMinutes, 0);
---

<PageLayout title="Teoría" description="Elige un curso para estudiar su teoría, tema por tema, con preguntas al final de cada uno.">
  <Container>
    <div class="page">
      <SectionHeading
        level={1}
        eyebrow="Estudia"
        title="Cursos"
        description="Elige un curso para ver sus temas. Cada tema termina con preguntas que lo marcan como completado."
      />
      <ul class="courses">
        {
          theory
            .courses()
            .map((course) => (
              <CourseCard course={course} topicCount={topics.length} domainCount={catalog.length} readingMinutes={readingMinutes} />
            ))
        }
      </ul>
    </div>
  </Container>
</PageLayout>

<style>
  .page {
    padding-top: var(--space-12);
  }

  .courses {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 24rem), 1fr));
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>

<script>
  import { theoryProgressStore } from '@/composition/theoryProgress';

  // Every topic belongs to the only course for now, so all completed topics count towards it.
  const completed = (await (await theoryProgressStore()).load()).length;
  for (const progress of document.querySelectorAll<HTMLElement>('[data-course-progress]')) {
    if (completed === 0) continue;
    progress.textContent = `${completed} de ${progress.dataset.total} temas completados`;
    progress.hidden = false;
  }
</script>
