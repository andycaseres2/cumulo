---
import { theory } from '@/composition/theory';
import ExamTaskList from '@/modules/theory/presentation/ExamTaskList.astro';
import SourceList from '@/modules/theory/presentation/SourceList.astro';
import TopicHeader from '@/modules/theory/presentation/TopicHeader.astro';
import TopicPager from '@/modules/theory/presentation/TopicPager.astro';
import Container from '@/ui/atoms/Container.astro';
import PageLayout from '@/ui/layouts/PageLayout.astro';
import Breadcrumbs from '@/ui/molecules/Breadcrumbs.astro';
import Prose from '@/ui/molecules/Prose.astro';
import { routes } from '@/ui/routes';

export async function getStaticPaths() {
  // Every topic belongs to the first course until the platform offers more than one.
  const [course] = theory.courses();
  const catalog = await theory.catalog();
  return catalog.flatMap((section) =>
    section.topics.map((topic) => ({ params: { course: course.slug, slug: topic.slug }, props: { course } })),
  );
}

const { slug } = Astro.params;
const { course } = Astro.props;
const navigation = await theory.navigation(slug);
if (!navigation) throw new Error(`Unknown theory topic: ${slug}`);

const { topic, domain, previous, next } = navigation;
const { Content, sources, quiz } = await theory.renderBody(slug);
---

<PageLayout title={topic.title} description={topic.summary}>
  <Container width="reading">
    <article class="topic">
      <Breadcrumbs
        items={[
          { label: 'Teoría', href: routes.theory },
          { label: course.title, href: routes.course(course.slug) },
          { label: domain.title, href: routes.theoryDomain(domain.id, course.slug) },
          { label: topic.title },
        ]}
      />
      <TopicHeader topic={topic} domain={domain} />
      <ExamTaskList taskIds={topic.examTasks} />
      <Prose><Content /></Prose>
      <SourceList sources={sources} />
      {quiz.length > 0 && <div data-topic-quiz data-slug={topic.slug} data-quiz={JSON.stringify(quiz)} />}
      <TopicPager previous={previous} next={next} />
    </article>
  </Container>
</PageLayout>

<style>
  .topic {
    padding-top: var(--space-8);
  }
</style>

<script>
  import { currentPlayer, playerAuth } from '@/composition/player';
  import { theoryProgressStore } from '@/composition/theoryProgress';
  import { openAuthModal } from '@/modules/player/presentation/authModal';
  import { recordQuizResult } from '@/modules/theory/application/theoryProgress';
  import type { QuizQuestion } from '@/modules/theory/domain/TheoryProgress';
  import { renderTopicQuiz } from '@/modules/theory/presentation/topicQuiz';

  const host = document.querySelector<HTMLElement>('[data-topic-quiz]');
  if (host) {
    const slug = host.dataset.slug!;
    const questions: QuizQuestion[] = JSON.parse(host.dataset.quiz ?? '[]');
    const [player, store] = await Promise.all([currentPlayer(), theoryProgressStore()]);
    renderTopicQuiz(host, {
      questions,
      completed: (await store.load()).includes(slug),
      signedIn: !player.isGuest,
      onFinished: (result) => recordQuizResult(store, slug, result),
      onSignIn: () => openAuthModal({ auth: playerAuth(), onSignedIn: () => window.location.reload() }),
    });
  }
</script>
