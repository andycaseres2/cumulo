---
import { LOCALES } from '@/i18n/locales';
import { SITE_NAME } from '@/ui/site';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>{SITE_NAME}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {LOCALES.map((code) => <link rel="alternate" hreflang={code} href={`/${code}/`} />)}
    <script is:inline>
      // The saved choice, else the first browser language the site speaks, else Spanish (same rule as pickLocale).
      (function () {
        var locales = ['es', 'en'];
        var saved = null;
        try {
          saved = window.localStorage.getItem('cumulo:locale');
        } catch (e) {}
        var pick = locales.indexOf(saved) >= 0 ? saved : null;
        var languages = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || ''];
        for (var i = 0; !pick && i < languages.length; i++) {
          var base = String(languages[i]).toLowerCase().split('-')[0];
          if (locales.indexOf(base) >= 0) pick = base;
        }
        window.location.replace('/' + (pick || 'es') + '/' + window.location.search + window.location.hash);
      })();
    </script>
  </head>
  <body style="background: #0f1730; color: #fff; font-family: sans-serif">
    <p><a href="/es/" style="color: #ffd166">Español</a> · <a href="/en/" style="color: #ffd166">English</a></p>
  </body>
</html>
