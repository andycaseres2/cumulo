---
import GameLayout from '@/ui/layouts/GameLayout.astro';
---

<GameLayout
  title="Nimbus City"
  description="Recorre Nimbus City como consultor cloud y ayuda a sus negocios con problemas reales de AWS."
  exitHref="/juegos"
>
  <div class="game-root" data-nimbus-city></div>
</GameLayout>

<style>
  /* Positioned so the mission panel overlay covers the game. */
  .game-root {
    position: relative;
    width: 100%;
    height: 100%;
  }

  /*
   * Behind the sign-in modal. A player who still has to pick a character sees the plain background
   * of the selection screen; one who already picked sees the city they are going back to.
   */
  .game-root.is-intro {
    background: #1d2b53;
  }

  .game-root.is-locked {
    background: url('/images/games/nimbus-city.png') center / cover no-repeat;
    image-rendering: pixelated;
  }
</style>

<script>
  import { gameMissions } from '@/composition/missions';
  import { chooseCharacter, currentPlayer, deviceHasCharacter, playerAuth, rememberCharacterOnDevice } from '@/composition/player';
  import { mountNimbusCity } from '@/modules/games/nimbus-city/mount';
  import { openAuthModal } from '@/modules/player/presentation/authModal';
  import { routes } from '@/ui/routes';

  const root = document.querySelector<HTMLElement>('[data-nimbus-city]');
  if (root) {
    const player = await currentPlayer();
    if (player.isGuest) {
      // Playing requires an account: ask for it right here, over what the player will see next.
      root.classList.add(deviceHasCharacter() ? 'is-locked' : 'is-intro');
      openAuthModal({
        auth: playerAuth(),
        reason: 'Necesitas una cuenta gratuita para jugar. Ingresa o créala en un minuto.',
        onSignedIn: () => window.location.reload(),
        onDismiss: () => window.location.assign(routes.games),
      });
    } else {
      if (player.character) rememberCharacterOnDevice();
      await mountNimbusCity(root, {
        playerName: player.displayName,
        missions: gameMissions(root),
        character: player.character,
        onCharacterChosen: (character) => void chooseCharacter(character),
      });
    }
  }
</script>
