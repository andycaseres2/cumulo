---
/** Signed-in players see their name and "Salir"; everyone else only sees "Ingresar". */
import { routes } from '@/ui/routes';
---

<div class="player" data-player-chip>
  <span class="player-chip" title="Tu jugador" data-player hidden>
    <span class="avatar" aria-hidden="true"></span>
    <span class="visually-hidden">Jugando como </span>
    <span data-player-name></span>
  </span>
  <a class="action" href={routes.signIn} data-sign-in>Ingresar</a>
  <button class="action" type="button" data-sign-out hidden>Salir</button>
</div>

<style>
  .player {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .player-chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-sm);
    font-weight: 600;
    background: var(--color-surface-raised);
    border: 2px solid var(--color-border);
    border-radius: 999px;
  }

  .avatar {
    width: 0.75rem;
    height: 0.75rem;
    background: var(--color-accent);
    border: 2px solid var(--color-shadow);
    border-radius: 2px;
  }

  .action {
    padding: var(--space-1) var(--space-3);
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-accent-ink);
    text-decoration: none;
    cursor: pointer;
    background: var(--color-accent);
    border: 2px solid var(--color-shadow);
    border-radius: 999px;
  }

  /* The display rules above would otherwise override the browser's [hidden] rule. */
  .player-chip[hidden],
  .action[hidden] {
    display: none;
  }
</style>

<script>
  import { currentPlayer, playerAuth } from '@/composition/player';
  import { openAuthModal } from '@/modules/player/presentation/authModal';

  // "Ingresar" opens the sign-in modal; the link to /ingresar stays as a fallback without JavaScript.
  for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-player-chip] [data-sign-in]')) {
    link.addEventListener('click', (event) => {
      event.preventDefault();
      openAuthModal({ auth: playerAuth(), onSignedIn: () => window.location.reload() });
    });
  }

  async function render() {
    const player = await currentPlayer();
    for (const chip of document.querySelectorAll<HTMLElement>('[data-player-chip]')) {
      chip.querySelector<HTMLElement>('[data-player]')!.hidden = player.isGuest;
      chip.querySelector('[data-player-name]')!.textContent = player.isGuest ? '' : player.displayName;
      chip.querySelector<HTMLElement>('[data-sign-in]')!.hidden = !player.isGuest;
      chip.querySelector<HTMLElement>('[data-sign-out]')!.hidden = player.isGuest;
    }
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-player-chip] [data-sign-out]')) {
    button.addEventListener('click', async () => {
      button.disabled = true;
      await playerAuth().signOut();
      window.location.reload();
    });
  }

  playerAuth().onChange(() => void render());
  await render();
</script>
