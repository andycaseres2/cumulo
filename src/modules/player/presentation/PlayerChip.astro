---
/** Signed-in players see a round avatar with their initials that opens their menu; everyone else sees "Ingresar". */
import { routes } from '@/ui/routes';
---

<div class="player" data-player-chip data-profile-url={routes.profile}>
  <div data-player-menu hidden></div>
  <a class="action" href={routes.signIn} data-sign-in>Ingresar</a>
</div>

<style>
  .player {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .action {
    padding: var(--space-1) var(--space-3);
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-accent-ink);
    text-decoration: none;
    cursor: pointer;
    background: var(--color-accent);
    border: 2px solid var(--color-shadow);
    border-radius: 999px;
  }

  /* The display rule above would otherwise override the browser's [hidden] rule. */
  .action[hidden] {
    display: none;
  }
</style>

<script>
  import { currentPlayer, playerAuth } from '@/composition/player';
  import { openAuthModal } from '@/modules/player/presentation/authModal';
  import { renderPlayerMenu } from '@/modules/player/presentation/playerMenu';
  import { routes } from '@/ui/routes';

  // "Ingresar" opens the sign-in modal; the link to /ingresar stays as a fallback without JavaScript.
  for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-player-chip] [data-sign-in]')) {
    link.addEventListener('click', (event) => {
      event.preventDefault();
      openAuthModal({ auth: playerAuth(), onSignedIn: () => window.location.reload() });
    });
  }

  async function signOut() {
    await playerAuth().signOut();
    // The profile only makes sense signed in.
    if (window.location.pathname.startsWith(routes.profile)) window.location.assign(routes.home);
    else window.location.reload();
  }

  async function render() {
    const player = await currentPlayer();
    for (const chip of document.querySelectorAll<HTMLElement>('[data-player-chip]')) {
      const menuHost = chip.querySelector<HTMLElement>('[data-player-menu]')!;
      chip.querySelector<HTMLElement>('[data-sign-in]')!.hidden = !player.isGuest;
      menuHost.hidden = player.isGuest;
      if (player.isGuest) menuHost.replaceChildren();
      else renderPlayerMenu(menuHost, { player, profileUrl: chip.dataset.profileUrl!, onSignOut: signOut });
    }
  }

  playerAuth().onChange(() => void render());
  await render();
</script>
