---
import { domainColor } from '@/modules/exam/presentation/domainColor';
import type { DomainSection } from '@/modules/theory/application/listTheoryCatalog';
import WeightStat from '@/ui/molecules/WeightStat.astro';
import TopicCard from './TopicCard.astro';

export interface Props {
  section: DomainSection;
}

const { section } = Astro.props;
const { domain, topics } = section;
---

<section class="domain" aria-labelledby={domain.id} style={`--domain-color: ${domainColor(domain.id)}`}>
  <header class="header">
    <p class="number">Dominio {domain.order}</p>
    <h2 id={domain.id}>{domain.title}</h2>
    <p class="description">{domain.description}</p>
    <WeightStat label="del examen" value={domain.weight} color={domainColor(domain.id)} />
    {/* Filled in the browser with the visitor's completed topics. */}
    {topics.some((t) => t.hasQuiz) && <p class="progress" data-domain-progress={domain.id} data-total={topics.length} hidden />}
  </header>
  {
    topics.length > 0 ? (
      <ul class="topics">
        {topics.map((topic) => (
          <li data-topic={topic.slug}>
            <TopicCard topic={topic} />
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty">Muy pronto agregaremos temas de este dominio.</p>
    )
  }
</section>

<style>
  .domain {
    padding-block: var(--space-8);
    border-top: var(--border-width) dashed var(--color-border);
  }

  .header {
    display: grid;
    gap: var(--space-3);
    max-width: var(--reading-width);
    margin-bottom: var(--space-8);
  }

  .number {
    margin: 0;
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--domain-color);
  }

  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1rem;
    line-height: 1.5;
    scroll-margin-top: var(--space-16);
  }

  .description {
    margin: 0;
    color: var(--color-text-muted);
  }

  .progress {
    justify-self: start;
    margin: 0;
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--domain-color);
    border: 2px solid var(--domain-color);
    border-radius: var(--radius);
  }

  .progress[hidden] {
    display: none;
  }

  .topics {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .empty {
    color: var(--color-text-muted);
  }
</style>
