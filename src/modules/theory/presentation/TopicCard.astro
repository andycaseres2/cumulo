---
import { domainColor } from '@/modules/exam/presentation/domainColor';
import type { Topic } from '@/modules/theory/domain/Topic';
import Card from '@/ui/molecules/Card.astro';
import { pagesMessages } from '@/i18n/messages/pages';
import { localeOf } from '@/i18n/page';
import { routesFor } from '@/ui/routes';

const locale = localeOf(Astro);
const routes = routesFor(locale);
const t = pagesMessages[locale].topic;

export interface Props {
  topic: Topic;
}

const { topic } = Astro.props;
---

<Card accent={domainColor(topic.domainId)} as="div">
  <h3 class="title"><a href={routes.topic(topic.slug)}>{topic.title}</a></h3>
  <p class="summary">{topic.summary}</p>
  <p class="meta">
    {t.reading(topic.readingMinutes)}{topic.services.length > 0 && ` · ${t.services(topic.services.length)}`}
    <span class="done" data-done hidden>{t.done}</span>
  </p>
</Card>

<style>
  .title {
    margin: 0;
    font-size: var(--text-lg);
    line-height: 1.35;
  }

  .title a {
    color: var(--color-text);
    text-decoration: none;
  }

  /* The whole card is clickable through the title link. */
  .title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .title a:hover {
    color: var(--color-accent);
  }

  .summary {
    margin: 0;
    color: var(--color-text-muted);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    margin: auto 0 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  /* Shown in the browser when the visitor completed the topic's quiz. */
  .done {
    padding: 0 var(--space-2);
    font-weight: 700;
    color: var(--color-accent-ink);
    background: var(--color-domain-technology-services);
    border-radius: var(--radius);
  }

  .done[hidden] {
    display: none;
  }
</style>
