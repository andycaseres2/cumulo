---
import type { ExamDomain } from '@/modules/exam/domain/ExamDomain';
import Badge from '@/ui/atoms/Badge.astro';
import { localeOf } from '@/i18n/page';
import { domainColor } from './domainColor';
import { domainText } from './examText';

export interface Props {
  domain: ExamDomain;
  variant?: 'solid' | 'outline';
}

const { domain, variant = 'outline' } = Astro.props;
---

<Badge color={domainColor(domain.id)} variant={variant}>{domainText(domain, localeOf(Astro)).title}</Badge>
