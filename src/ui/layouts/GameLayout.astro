---
import BaseLayout from './BaseLayout.astro';

export interface Props {
  title: string;
  description: string;
  exitHref: string;
}

const { title, description, exitHref } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <main class="stage">
    <slot />
    <a class="exit" href={exitHref}>← Salir</a>
  </main>
</BaseLayout>

<style>
  .stage {
    position: fixed;
    inset: 0;
    overflow: hidden;
    background: var(--color-surface);
  }

  /* Top left, above the game HUD (which starts below it), in the accent color so it is easy to find. */
  .exit {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    z-index: 10;
    padding: var(--space-2) var(--space-4);
    font-family: var(--font-display);
    font-size: 0.75rem;
    color: var(--color-accent-ink);
    text-decoration: none;
    background: var(--color-accent);
    border: var(--border-width) solid var(--color-shadow);
    border-radius: var(--radius);
    box-shadow: var(--shadow-pixel);
  }

  .exit:hover {
    background: var(--color-accent-strong);
  }
</style>
