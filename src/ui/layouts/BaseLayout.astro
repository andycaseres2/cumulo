---
import { LOCALES, swapLocale } from '@/i18n/locales';
import { siteMessages } from '@/i18n/messages/site';
import { localeOf } from '@/i18n/page';
import { SITE_NAME } from '@/ui/site';
import '@/ui/styles/global.css';

/** Shown when a page is shared on social networks or chats. */
const SOCIAL_IMAGE = '/images/games/cumulo-city.png';

export interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const fullTitle = title === SITE_NAME ? title : `${title} · ${SITE_NAME}`;
// Absolute URLs need the site address (SITE_URL); without it the canonical link and preview image are left out.
const canonical = Astro.site ? new URL(Astro.url.pathname.replace(/(.)\/$/, '$1'), Astro.site).href : undefined;
const previewImage = Astro.site ? new URL(SOCIAL_IMAGE, Astro.site).href : undefined;
const locale = localeOf(Astro);
/** The same page in every language, for search engines (absolute URLs, so only with SITE_URL). */
const alternates = Astro.site
  ? LOCALES.map((code) => ({ code, href: new URL(swapLocale(Astro.url.pathname, code).replace(/(.)\/$/, '$1'), Astro.site).href }))
  : [];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={siteMessages[locale].ogLocale} />
    {alternates.map((alternate) => <link rel="alternate" hreflang={alternate.code} href={alternate.href} />)}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {previewImage && <meta property="og:image" content={previewImage} />}
    <meta name="twitter:card" content={previewImage ? 'summary_large_image' : 'summary'} />
    <meta name="theme-color" content="#0f1730" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Press+Start+2P&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
