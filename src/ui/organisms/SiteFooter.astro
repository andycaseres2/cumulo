---
import Container from '@/ui/atoms/Container.astro';
import { siteMessages } from '@/i18n/messages/site';
import { localeOf } from '@/i18n/page';
import { SITE_NAME } from '@/ui/site';

const t = siteMessages[localeOf(Astro)].footer;
---

<footer class="site-footer">
  <Container>
    <p>{t.disclaimer(SITE_NAME)}</p>
    <p>
      {t.artBy} <a href="https://kenney.nl/assets/rpg-urban-pack" rel="noopener noreferrer" target="_blank"
        >{t.artPack}</a
      > (CC0).
    </p>
  </Container>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-16);
    padding-block: var(--space-8);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    border-top: var(--border-width) solid var(--color-border);
  }

  p {
    max-width: var(--reading-width);
    margin: 0;
  }

  p + p {
    margin-top: var(--space-2);
  }
</style>
