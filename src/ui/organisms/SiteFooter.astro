---
import Container from '@/ui/atoms/Container.astro';
import { SITE_NAME } from '@/ui/site';
---

<footer class="site-footer">
  <Container>
    <p>
      {SITE_NAME} es un proyecto independiente para preparar el examen AWS Certified Cloud Practitioner (CLF-C02). No está
      afiliado ni respaldado por Amazon Web Services.
    </p>
    <p>
      Arte del juego Nimbus City: <a href="https://kenney.nl/assets/rpg-urban-pack" rel="noopener noreferrer" target="_blank"
        >RPG Urban Pack de Kenney</a
      > (CC0).
    </p>
  </Container>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-16);
    padding-block: var(--space-8);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    border-top: var(--border-width) solid var(--color-border);
  }

  p {
    max-width: var(--reading-width);
    margin: 0;
  }

  p + p {
    margin-top: var(--space-2);
  }
</style>
