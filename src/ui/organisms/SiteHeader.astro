---
import PlayerChip from '@/modules/player/presentation/PlayerChip.astro';
import Container from '@/ui/atoms/Container.astro';
import { LOCALES, swapLocale } from '@/i18n/locales';
import { siteMessages } from '@/i18n/messages/site';
import { localeOf } from '@/i18n/page';
import { routesFor } from '@/ui/routes';
import { SITE_NAME } from '@/ui/site';

const locale = localeOf(Astro);
const routes = routesFor(locale);
const t = siteMessages[locale];

const NAV = [
  { label: t.nav.home, href: routes.home },
  { label: t.nav.games, href: routes.games },
  { label: t.nav.theory, href: routes.theory },
  { label: t.nav.practiceExam, href: routes.practiceExam },
];

const trim = (href: string) => href.replace(/\/$/, '');
const path = trim(Astro.url.pathname);
const isCurrent = (href: string) => (href === routes.home ? path === trim(href) : path === href || path.startsWith(`${href}/`));
/** The same page in each language, for the switch. */
const languages = LOCALES.map((code) => ({ code, label: t.language[code], href: swapLocale(Astro.url.pathname + Astro.url.search, code) }));
---

<header class="site-header">
  <Container>
    <div class="bar">
      <a class="brand" href={routes.home}>
        <span class="logo" aria-hidden="true"></span>
        {SITE_NAME}
      </a>
      <nav aria-label={t.nav.label}>
        <ul class="nav">
          {
            NAV.map((item) => (
              <li>
                <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div class="lang-switch" role="group" aria-label={t.language.label}>
        {
          languages.map((language) => (
            <a
              href={language.href}
              hreflang={language.code}
              lang={language.code}
              title={language.label}
              data-locale={language.code}
              aria-current={language.code === locale ? 'true' : undefined}
            >
              {language.code.toUpperCase()}
            </a>
          ))
        }
      </div>
      <PlayerChip />
    </div>
  </Container>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgb(15 23 48 / 92%);
    border-bottom: var(--border-width) solid var(--color-border);
    backdrop-filter: blur(6px);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-6);
    min-height: 4rem;
    padding-block: var(--space-2);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-display);
    font-size: 0.8rem;
    color: var(--color-accent);
    text-decoration: none;
  }

  .logo {
    width: 1.1rem;
    height: 0.7rem;
    background: var(--color-text);
    border-radius: 999px 999px 3px 3px;
    box-shadow:
      0.35rem -0.3rem 0 -0.05rem var(--color-text),
      2px 2px 0 var(--color-shadow);
  }

  nav {
    flex: 1;
  }

  .nav {
    display: flex;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav a {
    display: block;
    padding: var(--space-2) var(--space-3);
    font-weight: 600;
    color: var(--color-text-muted);
    text-decoration: none;
    border-radius: var(--radius);
  }

  .nav a:hover {
    color: var(--color-text);
    background: var(--color-surface);
  }

  .nav a[aria-current='page'] {
    color: var(--color-accent-ink);
    background: var(--color-accent);
  }

  .lang-switch {
    display: inline-flex;
    overflow: hidden;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius);
  }

  .lang-switch a {
    display: grid;
    place-items: center;
    min-width: 2.25rem;
    min-height: 2rem;
    padding: var(--space-1) var(--space-2);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .lang-switch a:hover {
    color: var(--color-text);
  }

  .lang-switch a[aria-current='true'] {
    color: var(--color-accent-ink);
    background: var(--color-accent);
  }

  @media (max-width: 560px) {
    nav {
      order: 3;
      flex-basis: 100%;
    }

    /* Brand on the left, language and account on the right; the menu takes its own row below. */
    .lang-switch {
      margin-left: auto;
    }

    /* Longer labels (English) scroll sideways instead of breaking the row. */
    .nav {
      overflow-x: auto;
      scrollbar-width: none;
    }

    .nav {
      justify-content: space-between;
    }

    .nav a {
      padding: var(--space-2);
      font-size: var(--text-sm);
      white-space: nowrap;
    }
  }

  /* The smallest phones (320 px). */
  @media (max-width: 360px) {
    .nav a {
      padding-inline: var(--space-1);
    }
  }
</style>

<script>
  import { LOCALE_STORAGE_KEY } from '@/i18n/locales';

  // A language picked by hand wins over the browser language on the next visits.
  for (const link of document.querySelectorAll<HTMLAnchorElement>('.lang-switch a[data-locale]')) {
    link.addEventListener('click', () => {
      try {
        window.localStorage.setItem(LOCALE_STORAGE_KEY, link.dataset.locale!);
      } catch {
        // Without storage the choice only lasts while the visitor follows the links.
      }
    });
  }
</script>
