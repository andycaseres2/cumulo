---
import PlayerChip from '@/modules/player/presentation/PlayerChip.astro';
import Container from '@/ui/atoms/Container.astro';
import { routes } from '@/ui/routes';

const NAV = [
  { label: 'Inicio', href: routes.home },
  { label: 'Juegos', href: routes.games },
  { label: 'Teoría', href: routes.theory },
  { label: 'Mi progreso', href: routes.progress },
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`));
---

<header class="site-header">
  <Container>
    <div class="bar">
      <a class="brand" href={routes.home}>
        <span class="logo" aria-hidden="true"></span>
        Nimbus City
      </a>
      <nav aria-label="Principal">
        <ul class="nav">
          {
            NAV.map((item) => (
              <li>
                <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <PlayerChip />
    </div>
  </Container>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgb(15 23 48 / 92%);
    border-bottom: var(--border-width) solid var(--color-border);
    backdrop-filter: blur(6px);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-6);
    min-height: 4rem;
    padding-block: var(--space-2);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-display);
    font-size: 0.8rem;
    color: var(--color-accent);
    text-decoration: none;
  }

  .logo {
    width: 1.1rem;
    height: 0.7rem;
    background: var(--color-text);
    border-radius: 999px 999px 3px 3px;
    box-shadow:
      0.35rem -0.3rem 0 -0.05rem var(--color-text),
      2px 2px 0 var(--color-shadow);
  }

  nav {
    flex: 1;
  }

  .nav {
    display: flex;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav a {
    display: block;
    padding: var(--space-2) var(--space-3);
    font-weight: 600;
    color: var(--color-text-muted);
    text-decoration: none;
    border-radius: var(--radius);
  }

  .nav a:hover {
    color: var(--color-text);
    background: var(--color-surface);
  }

  .nav a[aria-current='page'] {
    color: var(--color-accent-ink);
    background: var(--color-accent);
  }

  @media (max-width: 560px) {
    nav {
      order: 3;
      flex-basis: 100%;
    }
  }
</style>
