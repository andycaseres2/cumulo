---
/** Call to action. Renders a link when `href` is set, otherwise a native button. */
export interface Props {
  href?: string;
  variant?: 'primary' | 'secondary';
  size?: 'md' | 'lg';
  type?: 'button' | 'submit';
}

const { href, variant = 'primary', size = 'md', type = 'button' } = Astro.props;
const Tag = href ? 'a' : 'button';
---

<Tag class:list={['button', variant, size]} href={href} type={href ? undefined : type}>
  <slot />
</Tag>

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    font-family: var(--font-display);
    line-height: 1.4;
    text-decoration: none;
    border: var(--border-width) solid var(--color-shadow);
    border-radius: var(--radius);
    box-shadow: var(--shadow-pixel);
    cursor: pointer;
    transition:
      transform 80ms ease,
      box-shadow 80ms ease;
  }

  .button:hover {
    transform: translate(-1px, -1px);
    box-shadow: 5px 5px 0 var(--color-shadow);
  }

  .button:active {
    transform: translate(3px, 3px);
    box-shadow: 1px 1px 0 var(--color-shadow);
  }

  .md {
    padding: var(--space-3) var(--space-4);
    font-size: 0.625rem;
  }

  .lg {
    padding: var(--space-4) var(--space-6);
    font-size: 0.75rem;
  }

  .primary {
    color: var(--color-accent-ink);
    background: var(--color-accent);
  }

  .primary:hover {
    background: var(--color-accent-strong);
  }

  .secondary {
    color: var(--color-text);
    background: var(--color-surface-raised);
  }
</style>
