---
/** Centers content horizontally with the site gutters. */
export interface Props {
  width?: 'content' | 'reading';
}

const { width = 'content' } = Astro.props;
---

<div class:list={['container', width]}><slot /></div>

<style>
  .container {
    width: 100%;
    margin-inline: auto;
    padding-inline: var(--space-4);
  }

  .content {
    max-width: calc(var(--content-width) + 2 * var(--space-4));
  }

  .reading {
    max-width: calc(var(--reading-width) + 2 * var(--space-4));
  }
</style>
