---
/** Small label. `color` accepts any CSS color, including design tokens. */
export interface Props {
  color?: string;
  variant?: 'solid' | 'outline';
}

const { color = 'var(--color-accent)', variant = 'outline' } = Astro.props;
---

<span class:list={['badge', variant]} style={`--badge-color: ${color}`}><slot /></span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: 0.2rem 0.55rem;
    font-size: var(--text-xs);
    font-weight: 600;
    line-height: 1.4;
    white-space: nowrap;
    border: 2px solid var(--badge-color);
    border-radius: 999px;
  }

  .outline {
    color: var(--badge-color);
  }

  .solid {
    color: var(--color-accent-ink);
    background: var(--badge-color);
  }
</style>
